# Local default: HTTP. Set SITE_ADDRESS to your public hostname for automatic HTTPS.
{$SITE_ADDRESS::80} {
    encode zstd gzip

    @privatePages {
        path /mes-alertes /mes-alertes/* /app-shell.html
    }
    header @privatePages X-Robots-Tag "noindex, follow"
    @digestLinks query digest=*
    header @digestLinks X-Robots-Tag "noindex, follow"

    @api path /api /api/*
    handle @api {
        reverse_proxy api:3000
    }

    handle /sw.js {
        root * /srv
        header Cache-Control "no-cache"
        file_server
    }

    handle /assets/* {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle / {
        root * /srv
        header Cache-Control "no-cache"
        rewrite * /index.html
        file_server
    }

    handle {
        root * /srv
        header Cache-Control "no-cache"
        try_files {path} /app-shell.html
        file_server
    }
}
