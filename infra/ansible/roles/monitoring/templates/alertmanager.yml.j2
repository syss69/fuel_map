global:
  resolve_timeout: 5m

route:
  receiver: telegram
  group_by:
    - alertname
    - service
    - server
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: "{{ vault_telegram_bot_token }}"
        chat_id: {{ vault_telegram_chat_id | int }}
        parse_mode: HTML
        send_resolved: true
