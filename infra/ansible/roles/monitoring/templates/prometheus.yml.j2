global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: production-nodes
    static_configs:
{% for host in groups['production'] %}
      - targets:
          - "{{hostvars[host]['ansible_host'] }}:9100"
        labels:
          server: "{{ host }}"
{% endfor %}

  - job_name: blackbox-http
    metrics_path: /probe 
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - "{{ public_url }}"
        labels:
          service: trajetico-web
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115
