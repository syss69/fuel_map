# PostgreSQL with PostGIS enabled (shared by database scripts and API)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fuel_map
API_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
FUEL_DATASET_DEPARTMENT=64
FUEL_IMPORT_CRON=*/15 * * * *
FUEL_API_BASE_URL=https://data.economie.gouv.fr
# Resend key stays server-side. Generate a separate secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESEND_API_KEY=
EMAIL_FROM=Trajetico <bonjour@trajetico.space>
DIGEST_TOKEN_SECRET=
DIGEST_ENABLED=true
# Public frontend origin used in verification, unsubscribe and app links.
PUBLIC_APP_URL=http://localhost:5173
# Set only behind the corresponding number of trusted reverse proxies.
TRUST_PROXY_HOPS=0

# Vite (copy these values into apps/web/.env.local if starting Vite separately)
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
