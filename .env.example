# PostgreSQL with PostGIS enabled (shared by database scripts and API)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fuel_map
API_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
FUEL_DATASET_DEPARTMENT=64
FUEL_IMPORT_CRON=*/15 * * * *
FUEL_API_BASE_URL=https://data.economie.gouv.fr

# Vite (copy these values into apps/web/.env.local if starting Vite separately)
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
